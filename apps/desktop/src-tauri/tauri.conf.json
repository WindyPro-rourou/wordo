{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WORDO",
  "version": "0.1.0",
  "identifier": "app.wordo.desktop",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "WORDO 学习系统", "width": 1200, "height": 800, "minWidth": 800, "minHeight": 600, "resizable": true }],
    "security": { "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"] }
}