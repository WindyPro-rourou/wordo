{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wordo/output-schema/1/review-wrong.schema.json",
  "title": "WORDO T3 review-wrong",
  "type": "object",
  "additionalProperties": true,
  "required": ["task", "schema_ver", "warnings", "reviews", "inferred"],
  "properties": {
    "task": { "const": "review-wrong" },
    "schema_ver": { "const": "1" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "kc_id", "why_wrong_md", "fix_md", "variant"],
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "kc_id": { "type": "string", "minLength": 1 },
          "why_wrong_md": { "type": "string", "minLength": 4 },
          "fix_md": { "type": "string", "minLength": 8 },
          "variant": {
            "type": "object",
            "required": ["stem", "options", "answer"],
            "properties": {
              "stem": { "type": "string", "minLength": 3 },
              "options": { "type": "array", "minItems": 2, "items": { "type": "string" } },
              "answer": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "inferred": { "type": "boolean" }
  }
}
